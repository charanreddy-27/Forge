# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=forge

# Connection string used by the agent layer.
# Inside docker compose the host is `postgres`; for local dev use `localhost`.
DATABASE_URL=postgresql+psycopg://forge:forge@postgres:5432/forge

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── n8n ─────────────────────────────────────────────────────────────────────
# API key for n8n's public REST API (create one in the n8n UI: Settings → API).
# Used by the engine adapter from Phase 2 onward.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=

# ── LLM Gateway ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Default model for agent-layer LLM calls.
ANTHROPIC_MODEL=claude-opus-4-8
# Hard daily spend limit in USD across ALL services. Calls are refused once
# today's logged cost reaches this number.
LLM_DAILY_BUDGET_USD=10.00
# Retries for transient Anthropic errors (429 / 5xx / connection).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=2.0

# Local Ollama fallback (used when Anthropic is unreachable after retries).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
