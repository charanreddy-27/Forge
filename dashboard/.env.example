# Dashboard (Next.js) environment.
#
# DEMO MODE IS THE ZERO-CONFIG DEFAULT. With no variables set at all, the
# dashboard runs entirely on the seeded dataset in lib/demo.ts — the chat box and
# incident actions simulate the agent client-side too. This is what makes the
# Vercel deployment work with no backend and no configuration.
#
# You only need the variables below if you want to change that.

# Optional: your public URL — makes OpenGraph/Twitter card links absolute.
# NEXT_PUBLIC_SITE_URL=https://forge-ops.vercel.app

# --- Live mode (self-hosted backend) -------------------------------------
# Set this to a running agent layer to read REAL data instead of the demo
# dataset. Its presence is what switches the app out of demo mode. In
# docker-compose this is set for you (http://agent-layer:8000).
# FORGE_API_URL=https://your-agent-layer-host
